# Copie para .env.local (fica fora do git) e preencha.
# Na Vercel, as mesmas variáveis vão em Settings → Environment Variables.
# Nenhuma delas tem prefixo VITE_: só o servidor (pasta api/) lê.

# Postgres: com pooler (app) e direta (schema/scripts)
DATABASE_URL=postgresql://usuario:senha@host-pooler/banco?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@host/banco?sslmode=require

# Login do /admin
ADMIN_EMAIL=voce@exemplo.com
# gere com: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=scrypt:...
# texto aleatório (mín. 32 caracteres), ex.: openssl rand -base64 48
# trocar ele derruba todas as sessões do admin
SESSION_SECRET=
