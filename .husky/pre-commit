echo "🔍 Verificando build antes do commit..."

# Esconde as mudanças fora do stage para buildar só o que vai ser commitado.
# `git stash push` não cria stash quando não há nada a guardar, então só
# fazemos pop se o número de stashes mudou (senão aplicaríamos um stash antigo).
STASH_COUNT_BEFORE=$(git stash list | wc -l)
git stash push -q --keep-index --include-untracked -m "pre-commit"
STASH_COUNT_AFTER=$(git stash list | wc -l)

npm run verify-build
BUILD_STATUS=$?

if [ "$STASH_COUNT_AFTER" -ne "$STASH_COUNT_BEFORE" ]; then
  git stash pop -q
fi

if [ $BUILD_STATUS -ne 0 ]; then
  echo "❌ Build falhou! Corrija os erros antes de commitar."
  exit 1
fi

echo "✅ Build passou! Prosseguindo com o commit..."
exit 0
